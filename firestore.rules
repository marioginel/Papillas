rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estos dos emails pueden leer y escribir. Cámbialos por los vuestros (en minúsculas).
    function familia() {
      return request.auth != null
        && request.auth.token.email in [
          'tu-email@ejemplo.com',
          'email-de-tu-mujer@ejemplo.com'
        ];
    }

    match /{document=**} {
      allow read, write: if familia();
    }
  }
}
